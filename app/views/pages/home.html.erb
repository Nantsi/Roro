<div class="container-text-center">
  <div class="row" style="height: 120px; padding-top: 20px; padding-bottom: 20px; padding-left: 20px;">
    <div class="col">
      <h1>I miss Roro! <img src="https://media.discordapp.net/stickers/1249654938750160926.webp?size=160&quality=lossless" alt="Roro" width="50" height="50"></h1>
    </div>
    
  </div>
</div>


<div class="container-fluid">
  <% channel = @channel["items"].first %>
  <% video_id = @latest_video["snippet"]["resourceId"]["videoId"] %>
  <% video_url = "https://www.youtube.com/watch?v=#{video_id}" %>



  <div class="card">
    <img
      class="card-img-top"
      src="<%= channel["snippet"]["thumbnails"]["high"]["url"] %>"
    >

    <div class="card-body">
      <h3 class="card-title">
        <%= channel["snippet"]["title"] %>
      </h3>

      <p class="card-text">
        <%= channel["snippet"]["description"] %>
      </p>

    


      

      <h2>Latest Upload</h2>

      <%= link_to video_url, target: "_blank" do %>
        <%= image_tag(
          @latest_video["snippet"]["thumbnails"]["high"]["url"],
          alt: @latest_video["snippet"]["title"],
          class: "img-fluid"
        ) %>
      <% end %>

      <h3>
        <%= link_to(
          @latest_video["snippet"]["title"],
          video_url,
          target: "_blank",
          class: "text-black"
        ) %>
      </h3>

      <span id="upload-date"
        data-uploaded-at="<%= @latest_video["snippet"]["publishedAt"] %>">
      </span>   

      <p>
        <span
            id="upload-time"
            data-uploaded-at="<%= @latest_video["snippet"]["publishedAt"] %>">
        </span>
      </p>


    </div>
  </div>
</div>