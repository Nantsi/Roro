<div class="container-fluid" style=" padding-bottom: 40px;">
 <% if @livestream %>
  <% else %>
    <div class="container-fluid" style=" padding-top: 40px;">
      <div class="row">
      
      <% if Date.today.month == 8 && Date.today.day == 8 %>
      <h1 class="text-center">HAPPY BIRTHDAY RORO! <img src="https://media.discordapp.net/stickers/1249656309796835349.webp?size=160&quality=lossless" alt="RoroCheer" width="50" height="50"></h1> 
      <% else %>
      <h1 class="text-center">I MISS RORO UUUUUuuuuuUUUUU! <img src="https://media.discordapp.net/stickers/1249654938750160926.webp?size=160&quality=lossless" alt="RoroCry" width="50" height="50"></h1> 
      
      <% end %>
      
      
      </div>
    </div>
  <% end %>

  <div class="container-fluid" style="padding-top: 20px;">
    <% if @livestream %>
    <% video_id = @livestream["id"]["videoId"] %>
    <% video_url = "https://www.youtube.com/watch?v=#{video_id}" %>
        <div class="text-center"> 

        <% if Date.today.month == 8 && Date.today.day == 8 %>
      <h3 class="text-center">RORO IS LIVE NOW GO SAY HAPPY BIRTHDAY! <img src="https://media.discordapp.net/stickers/1249656309796835349.webp?size=160&quality=lossless" alt="RoroCheer" width="50" height="50"></h3> 
      <% else %>
      <h3 class="text-center">RORO IS LIVE NOW! <img src="https://media.discordapp.net/stickers/1249656309796835349.webp?size=160&quality=lossless" alt="RoroCheer" width="50" height="50"></h3> 
      
      <% end %>
        
        

        <%= link_to video_url, target: "_blank" do %>
          <%= image_tag(
            @latest_video["snippet"]["thumbnails"]["maxres"]["url"],
            style: "max-height: 450px;  padding-top: 20px; padding-bottom: 20px; padding-left: 20px; padding-right: 20px;"
          ) %>


          
      <div>

        <h3>
          <%= link_to(
            @latest_video["snippet"]["title"],
            video_url,
            target: "_blank",
            class: "text-black"
          ) %>
        </h3>

      </div>

          </div>
    <% end %>
    <% else %>
          <h2 class="text-center" style="padding-bottom: 20px;">
          <span
              id="upload-time"
              data-uploaded-at="<%= @latest_video["snippet"]["publishedAt"] %>">
          </span>
        </h2>
    <% end %>


  </div>


  <div class="container-fluid">
    <% channel = @channel["items"].first %>
    <% video_id = @latest_video["snippet"]["resourceId"]["videoId"] %>
    <% video_url = "https://www.youtube.com/watch?v=#{video_id}" %>


  <div class="container-text-center" style="padding-top: 40px;">
    <div class="row">
        <div class="col-md-4" style="margin-top: 20px;">
            <div class="card h-100 youtube-card" style="background-color: #FDE2EE;">

              <img
                class="card-img-top" style= "max-height: 50%; object-fit: cover; padding-top: 20px; padding-bottom: 20px; padding-left: 20px; padding-right: 20px;"
                src="<%= channel["snippet"]["thumbnails"]["high"]["url"] %>"
              >
              

              <div class="card-body text-center">
              
                <h3>
                    <%= link_to(
                      channel["snippet"]["title"],
                      "https://www.youtube.com/@HiranoKokoro",
                      target: "_blank",
                      class: "text-black"
                    ) %>
                </h3>

                
                

                <p class="card-text">
                  HARORO.ᐟ.ᐟ ☆ Hockey vtuber, skating straight into your heart.ᐟ 🏒🌸 (☆｀• ᴗ •´)૭

                  big yaps, chaotic gameplays, tingly asmr and maybe a few sweet hat tricks along the way! ₊˚ෆˎˊ˗

                  📺 Streaming on both YouTube & Twitch ☆ 
                </p>

              </div>
            </div>
          </div>
        <div class="col-md-4" style=" margin-top: 20px;">
                  <div class="card h-100 youtube-card" style="background-color: #FDE2EE;">
                    
                      

                       <div class="text-center" style="padding-top: 20px, padding-bottom: 20px">
                        <%= link_to video_url, target: "_blank" do %>
                          <%= image_tag(
                            @latest_video["snippet"]["thumbnails"]["maxres"]["url"],
                            alt: @latest_video["snippet"]["title"],
                            class: "img-fluid",
                            style: "max-height: 100%; object-fit: cover; padding-top: 20px; padding-left: 20px; padding-right: 20px;"
                          ) %>
                        <% end %>
                      </div>

                      <div class="card-body d-flex flex-column text-center">

                        <h3>
                          <%= link_to(
                            @latest_video["snippet"]["title"],
                            video_url,
                            target: "_blank",
                            class: "text-black"
                          ) %>
                        </h3>

                        <span id="upload-date"
                          data-uploaded-at="<%= @latest_video["snippet"]["publishedAt"]
                          %>">
                          
                        </span>   

                        <div class="text-center mt-auto" style="padding-top: 20px">
                          <h2>
                          Latest Upload
                          </h2>
                        </div>

                        
                    </div>
      </div>
      
    </div>
    <div class="col-md-4" style="margin-top: 20px;">
                  <div class="card h-100 youtube-card" style="background-color: #FDE2EE;">

                    <div class="text-center">
                        <%= link_to "https://o8studio.com/", target: "_blank" do %>
                          <%= image_tag(
                            "o8Logo.webp",
                            alt: "o8Logo",
                            class: "img-fluid",
                            style: "max-height: 100%; object-fit: cover;  padding-left: 20px; padding-right: 20px;"
                          ) %>
                        <% end %>
                      </div>
                    <div class="card-body text-center">
                      
                      

                        <h3 class="card-text">
                          <%= link_to(
                            "o!8 Studio",
                            "https://o8studio.com/",
                            target: "_blank",
                            class: "text-black"
                          ) %>
                        </h3> 
                    </div>
    </div>
  </div>
 
</div>
</div>
</div>

<div class="container-fluid" style="padding-top: 40px; padding-bottom: 20px;">
    <h2 class="text-center">Upcoming Streams:</h2>
      <div class="row">


      <% @upcoming_streams.each do |stream| %>
                <div class="col-md-4" style="margin-top: 20px;">

        <div class="card youtube-card" style="padding-top: 20px; background-color: #FDE2EE;">
         


                        <div class="text-center" style="padding-top: 20px, padding-bottom: 20px">
                        <%= link_to "https://www.youtube.com/watch?v=#{stream["snippet"]["resourceId"]["videoId"]}", target: "_blank" do %>
                          <%= image_tag(
                            stream["snippet"]["thumbnails"]["maxres"]["url"],
                            alt: stream["snippet"]["title"],
                            class: "img-fluid",
                            style: "max-height: 100%; object-fit: cover; padding-top: 20px; padding-left: 20px; padding-right: 20px;"
                          ) %>
                        <% end %>
                      </div>

          <div class="card-body d-flex flex-column text-center">
            

            <h3>
                          <%= link_to(
                            stream["snippet"]["title"],
                            "https://www.youtube.com/watch?v=#{stream["snippet"]["resourceId"]["videoId"]}",
                            target: "_blank",
                            class: "text-black"
                          ) %>
                        </h3>

            <% if @upcoming_times %>
              <span
                class="upcoming-time"
                data-uploaded-at="<%= @upcoming_times[@upcoming_streams.index(stream)] %>">
              </span>
                        

            <% end %>

            
          </div>
        </div>
        </div>
      <% end %>
</div>
</div>
  </div>
  </div>
<footer class="text-center py-4 border-top" style="background-color: #FFDB7E;">
  <div class="d-flex justify-content-center gap-4"> 
                            <h3 class="text-center">Roro&apos;s Social Media</h3>
  </div>
  <div class="d-flex justify-content-center gap-4">

    <a href="https://www.youtube.com/@hiranokokoro" target="_blank" class="text-dark">
      <i class="bi bi-youtube fs-3" style="color: red;"></i>
    </a>

    <a href="https://www.twitch.tv/hiranokokoro" target="_blank" class="text-dark">
      <i class="bi bi-twitch fs-3" style="color: purple;"></i>
    </a>

    <a href="https://x.com/@hiranokokoroch" target="_blank" class="text-dark">
      <i class="bi bi-twitter-x fs-3"></i>
    </a>

    <a href="https://www.hiranokokoro.com/" target="_blank" class="text-dark fs-3 text-decoration-none">
      🏒🌸
    </a>

  </div>
  
                           <small class="position-relative bottom-0 end-0 me-3 mb-2"> Not affiliated with Roro. All complaints to @nantsi43 on twitter </small>
  
</footer>
